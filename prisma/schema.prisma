generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  color       String
  size        String
  brandId     Int
  brand       Brand    @relation(fields: [brandId], references: [id])
  imageUrl    String
  price       Float    @default(0)
  retailerPrice    Float    @default(0)
  dealerPrice      Float    @default(0)
  distributorPrice Float    @default(0)
  bulkPrice        Float    @default(0)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(10)
  category    String   @default("general")
  description String?
  moq         Int      @default(1)
  tags        String   @default("")
  hsnCode     String   @default("3924")
  gstRate     Float    @default(18.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  email       String?
  address     String?
  tier        String   @default("retailer")
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime @default(now())
  orders      Order[] @relation("CustomerOrders")
}

model Order {
  id         Int         @id @default(autoincrement())
  customer   String
  phone      String
  address    String?
  total      Float
  status     String      @default("pending")
  notes      String?
  customerId Int?
  customerRef Customer? @relation("CustomerOrders", fields: [customerId], references: [id])
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Invoice {
  id             Int          @id @default(autoincrement())
  invoiceNumber  String       @unique
  orderId        Int?
  customerName   String
  customerPhone  String
  customerAddress String?
  customerGstin  String?
  placeOfSupply  String       @default("Maharashtra")
  subtotal       Float
  cgst           Float
  sgst           Float
  igst           Float
  total          Float
  status         String       @default("draft")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productName String
  hsnCode     String
  quantity    Int
  unitPrice   Float
  gstRate     Float
  cgst        Float
  sgst        Float
  igst        Float
  total       Float
}

model PriceLock {
  id         Int      @id @default(autoincrement())
  productId  Int
  lockedPrice Float
  lockedAt   DateTime @default(now())
  expiresAt  DateTime
  status     String   @default("active")
  notes      String?
  createdAt  DateTime @default(now())
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  oldPrice   Float
  newPrice   Float
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())
}

model RecurringOrder {
  id                Int      @id @default(autoincrement())
  customerId        Int
  productId         Int
  productName       String
  quantity          Int
  frequency         String   @default("weekly")
  nextOrderDate     DateTime
  lastOrderDate     DateTime?
  status            String   @default("active")
  pricePerUnit      Float
  totalOrders       Int      @default(0)
  whatsappConfirmed Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String?
  gstNumber String?
  notes     String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  productId     Int
  productName   String
  quantity      Int
  unitCost      Float
  totalCost     Float
  status        String   @default("pending")
  expectedDate  DateTime?
  receivedDate  DateTime?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeliverySlot {
  id        Int      @id @default(autoincrement())
  label     String
  startTime String
  endTime   String
  maxOrders Int      @default(5)
  active    Boolean  @default(true)
}

model DeliverySchedule {
  id          Int      @id @default(autoincrement())
  orderId     Int
  customerId  Int
  slotId      Int
  date        DateTime
  address     String
  pincode     String
  contactPhone String
  status      String   @default("scheduled")
  driverName  String?
  driverPhone String?
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
