generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  color       String
  size        String
  brandId     Int
  brand       Brand    @relation(fields: [brandId], references: [id])
  imageUrl    String
  price       Float    @default(0)
  retailerPrice    Float    @default(0)
  dealerPrice      Float    @default(0)
  distributorPrice Float    @default(0)
  bulkPrice        Float    @default(0)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(10)
  category    String   @default("general")
  subCategory String?
  description String?
  height      Float?
  width       Float?
  depth       Float?
  weight      Float?
  moq         Int      @default(1)
  tags        String   @default("")
  hsnCode     String   @default("3924")
  gstRate     Float    @default(18.0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
  images      ProductImage[]
  priceLocks  PriceLock[]
  priceHistory PriceHistory[]
  recurringOrders RecurringOrder[]
  purchaseOrders  PurchaseOrder[]
  bundleItems BundleItem[]

  @@index([brandId])
  @@index([category])
  @@index([subCategory])
  @@index([createdAt])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([approved])
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  email       String?
  address     String?
  tier        String   @default("retailer")
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime @default(now())
  orders      Order[] @relation("CustomerOrders")
  recurringOrders RecurringOrder[] @relation("RecurringOrders")
  deliveries  DeliverySchedule[] @relation("Deliveries")
  ledgerEntries LedgerEntry[] @relation("LedgerEntries")
}

model Order {
  id              Int               @id @default(autoincrement())
  publicId        String            @unique
  customer        String
  phone           String
  address         String?
  total           Float
  status          String            @default("pending")
  deliveryMethod  String            @default("delivery")
  paymentMethod   String?           @default("cod")
  paymentStatus   String            @default("unpaid")
  paymentNote     String?
  trackingToken   String?           @unique
  notes           String?
  customerId      Int?
  customerRef     Customer?         @relation("CustomerOrders", fields: [customerId], references: [id])
  items           OrderItem[]
  invoices        Invoice[]
  deliveries      DeliverySchedule[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([trackingToken])
  @@index([createdAt])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  timestamp DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  color     String?

  @@index([orderId])
  @@index([productId])
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Invoice {
  id             Int          @id @default(autoincrement())
  invoiceNumber  String       @unique
  orderId        Int?
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  customerAddress String?
  customerGstin  String?
  placeOfSupply  String       @default("Maharashtra")
  subtotal       Float
  cgst           Float
  sgst           Float
  igst           Float
  total          Float
  status         String       @default("draft")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          InvoiceItem[]

  @@index([orderId])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productName String
  hsnCode     String
  quantity    Int
  unitPrice   Float
  gstRate     Float
  cgst        Float
  sgst        Float
  igst        Float
  total       Float

  @@index([invoiceId])
}

model PriceLock {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lockedPrice Float
  lockedAt   DateTime @default(now())
  expiresAt  DateTime
  status     String   @default("active")
  notes      String?
  createdAt  DateTime @default(now())

  @@index([productId])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice   Float
  newPrice   Float
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([productId])
}

model RecurringOrder {
  id                Int      @id @default(autoincrement())
  customerId        Int
  customer          Customer @relation("RecurringOrders", fields: [customerId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName       String
  quantity          Int
  frequency         String   @default("weekly")
  nextOrderDate     DateTime
  lastOrderDate     DateTime?
  status            String   @default("active")
  pricePerUnit      Float
  totalOrders       Int      @default(0)
  whatsappConfirmed Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([customerId])
  @@index([productId])
}

model Supplier {
  id            Int              @id @default(autoincrement())
  name          String
  phone         String
  email         String?
  address       String?
  gstNumber     String?
  notes         String?
  createdAt     DateTime         @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName   String
  quantity      Int
  unitCost      Float
  totalCost     Float
  status        String   @default("pending")
  expectedDate  DateTime?
  receivedDate  DateTime?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([supplierId])
  @@index([productId])
}

model DeliverySlot {
  id        Int      @id @default(autoincrement())
  label     String
  startTime String
  endTime   String
  maxOrders Int      @default(5)
  active    Boolean  @default(true)
  schedules DeliverySchedule[]
}

model DeliverySchedule {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  Int
  customer    Customer @relation("Deliveries", fields: [customerId], references: [id], onDelete: Cascade)
  slotId      Int
  slot        DeliverySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date        DateTime
  address     String
  pincode     String
  contactPhone String
  status      String   @default("scheduled")
  driverName  String?
  driverPhone String?
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([slotId])
}

model LedgerEntry {
  id           Int      @id @default(autoincrement())
  customerId   Int
  customer     Customer @relation("LedgerEntries", fields: [customerId], references: [id], onDelete: Cascade)
  orderId      Int?
  type         String
  amount       Float
  balance      Float
  description  String
  referenceNo  String?
  createdAt    DateTime @default(now())

  @@index([customerId])
}

model Bundle {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  totalOriginal Float
  bundlePrice  Float
  discount    Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       BundleItem[]
}

model BundleItem {
  id        Int     @id @default(autoincrement())
  bundleId  Int
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)

  @@index([productId])
}

model CustomerUser {
  id        Int      @id @default(autoincrement())
  googleId  String   @unique
  name      String
  email     String   @unique
  phone     String?
  image     String?
  createdAt DateTime @default(now())
  wishlist  WishlistItem[]
  sessions  Session[]
}

model WishlistItem {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime    @default(now())

  @@unique([userId, productId])
}

model Session {
  id           String   @id
  userId       Int
  user         CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   @default("info")
  title     String
  message   String
  orderId   Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([read])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
